<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive Laravel files if deployed directly in public_html
    RewriteRule ^(\.env|composer\.json|composer\.lock|artisan|phpunit\.xml|package\.json) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Route all requests to Laravel's public/ front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
